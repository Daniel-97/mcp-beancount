{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "beancount-fixture": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "beancount-mcp",
          "--read-only",
          "tests/fixtures/minimal/main.bean"
        ],
        "cwd": "."
      },
      "beancount-test": {
        "type": "local",
        "command": [
          "uv",
          "run",
          "beancount-mcp",
          "--verbose",
          "test-ledger/main.bean"
        ],
        "cwd": ".",
        "disabled": true
      }
    }
  }
}
